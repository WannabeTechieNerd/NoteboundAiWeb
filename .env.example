# GEMINI_API_KEY: Required for Gemma / Gemini AI API calls.
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model selection in Google GenAI API
GEMMA_MODEL_NAME=gemini-2.5-flash

# Fallback model if primary model encounters rate-limiting
FALLBACK_MODEL_NAME=gemini-1.5-flash

# Server port (opens at http://localhost:3000)
PORT=3000

# ==========================================================
# Local MySQL Database Configuration (Per-User Storage)
# ==========================================================
# Copy this file to `.env` on your computer and set MYSQL_PASSWORD
# to match your local MySQL Server user credentials.
# NoteBound AI automatically creates the `notebound_ai` database
# and all 10 tables on startup!
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=notebound_ai
MYSQL_SSL=false

# Set MYSQL_STRICT=true locally so the server requires MySQL
# instead of falling back to disk storage if MySQL is stopped.
MYSQL_STRICT=true
